<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # L'application Flutter occupe la racine ; PHP ne sert plus que l'API.
    DirectoryIndex index.html index.php

    RewriteEngine On

    # HTTPS obligatoire (CONTEXT §13). Sur TLS, Apache donne `HTTPS=on` et le
    # proxy `X-Forwarded-Proto: https` (vérifié le 28 novembre 2026 par un
    # fichier de diagnostic temporaire) ; en HTTP simple, ni l'un ni l'autre
    # n'est présent : la redirection ne peut pas boucler. Elle passe avant
    # tout le reste, API comprise.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Anciennes adresses publiées sous /site/ : redirection permanente vers la
    # racine, pour que les liens déjà partagés continuent de fonctionner. La
    # barre est obligatoire : sans elle, « /sitemap.xml » serait lu comme
    # « /site » + « map.xml » et redirigé vers /map.xml.
    RewriteRule ^site(?:/(.*))?$ /$1 [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # API et panneau éditorial (/admin, écrans Blade) : requêtes traitées par
    # Laravel. `livewire` et `sanctum` restent dans le motif au cas où une page
    # du panneau les appellerait un jour ; aucun des deux n'est installé.
    RewriteRule ^(api|admin|livewire|sanctum|up)(/|$) index.php [L]

    # Pages d'articles pré-rendues et sitemap : Laravel produit le HTML et le
    # XML, pour que les moteurs de recherche et les cartes de partage voient
    # le contenu au lieu de la coquille Flutter.
    RewriteRule ^articles/[^/]+$ index.php [L]
    RewriteRule ^sitemap\.xml$ index.php [L]

    # Brotli précompressé au déploiement (`tools/precompress_web.py`, qualité
    # 11, une fois par build) : quand le navigateur annonce `br` et que la
    # variante `<fichier>.br` existe à côté de l'original, c'est elle qui
    # part. Le brotli dynamique reste coupé (trop lent à la volée) : ici le
    # serveur ne fait que servir des octets déjà compressés. Cette règle
    # précède « Fichiers réels », sinon le fichier non compressé partirait
    # d'office avec son drapeau [L].
    RewriteCond %{HTTP:Accept-Encoding} br
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME}.br -f
    RewriteRule ^(.+\.(?:js|wasm|ttf))$ $1.br [L]

    # Fichiers réels : assets Flutter, polices, CanvasKit, manifeste.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Toute autre adresse est une route de l'application (/statistiques,
    # /histoires, /categories/{slug}...) : elle reçoit la page HTML du
    # bootstrap, qui reconstruit l'écran à partir de l'URL.
    RewriteRule ^ index.html [L]
</IfModule>

# Le moteur de rendu de Flutter (CanvasKit) est un WebAssembly de 7,3 Mo et
# le JavaScript pèse près de 3 Mo. Apache ne compresse pas ce WebAssembly par
# défaut : sans ces règles, le premier chargement attendait plus d'une minute
# sur une connexion ordinaire.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Brotli à la volée divise par cinq le débit des gros fichiers (mesuré sur
# main.dart.js : 733 ko en 120 s en brotli contre 833 ko en 28 s en gzip).
# Comme l'application pèse plus de 800 ko de JavaScript, la compression brotli
# empêchait la page de se charger. On la désactive pour les fichiers lourds :
# gzip reste actif et suffit.
# Les variantes `.br` déjà compressées sont exclues elles aussi : après la
# réécriture, leur adresse finit en `.br`, le motif ci-dessus ne correspond
# plus, et le module recompressait la variante (brotli de brotli, illisible
# par le navigateur : écran de chargement bloqué, novembre 2026). Même
# garde-fou côté gzip, par précaution.
<IfModule mod_brotli.c>
  SetEnvIfNoCase Request_URI "\.(js|wasm|json|ttf|otf|woff2?)$" no-brotli
  SetEnvIfNoCase Request_URI "\.br$" no-brotli
</IfModule>
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI "\.br$" no-gzip
</IfModule>

<IfModule mod_headers.c>
  # En-têtes de sécurité (CONTEXT §13, docs/SECURITE.md). Ils s'appliquent à
  # tout ce que sert cette racine : la coquille Flutter, les articles
  # pré-rendus, l'API et le panneau.
  #   - X-Frame-Options : le site ne se laisse pas encadrer ailleurs ;
  #   - nosniff : le navigateur ne devine pas un type qu'on n'a pas annoncé ;
  #   - Referrer-Policy : l'adresse d'origine ne fuit pas vers les sites tiers
  #     (partage, liens d'articles) ;
  #   - HSTS : un an sans repasser par HTTP (ignoré en HTTP simple, donc posé
  #     sans condition).
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"

  # CSP **bloquante** depuis la séance 142 : ce qui n'est pas listé est refusé,
  # pas seulement signalé. Trois besoins réels la dimensionnent :
  #   - Flutter Web charge son moteur depuis la même origine et compile du
  #     WebAssembly, d'où 'wasm-unsafe-eval' (et pas 'unsafe-eval') ;
  #   - les feuilles de style et les polices sont injectées à la volée par le
  #     moteur, d'où 'unsafe-inline' pour style-src et data: pour les polices ;
  #   - les couvertures d'articles sont des images sourcées, hébergées par
  #     Wikimedia : sans ces deux hôtes, 75 articles perdraient leur image ;
  #   - le moteur télécharge Roboto, police par défaut de Material, sur
  #     fonts.gstatic.com : sans cet hôte, les textes sans famille explicite
  #     perdent leur police (l'appel passe par fetch, donc connect-src aussi).
  # Aucun script en ligne ne subsiste (couverture → `loading.js`, formulaire
  # d'article → `admin/article-form.js`) : script-src reste sans 'unsafe-inline',
  # et le moteur Flutter est servi par le site (`--no-web-resources-cdn`),
  # jamais depuis un CDN de scripts.
  # Ajouter un hôte est un acte explicite — une ligne ici, documentée dans
  # docs/SECURITE.md §1.1.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://upload.wikimedia.org https://thumb.wikimedia.org; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://fonts.gstatic.com; media-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # Le code doit être revalidé à chaque visite : une réponse 304 coûte quelques
  # centaines d'octets et un déploiement est visible immédiatement.
  <FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # CanvasKit et les polices pèsent plusieurs mégaoctets et ne changent qu'avec
  # une montée de version de Flutter : un jour de cache évite de les reprendre
  # à chaque visite, sans figer durablement une version périmée.
  <FilesMatch "\.(wasm|ttf|otf|woff2?|png|webp|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Les polices d'icônes sont réduites à chaque build : les glyphes changent
  # avec le code. Les garder un jour en cache faisait apparaître vide toute
  # icône ajoutée depuis la visite précédente. Elles pèsent ~13 ko : on les
  # revalide systématiquement.
  <FilesMatch "^(MaterialIcons-Regular\.otf|CupertinoIcons\.ttf)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Variantes précompressées : l'encodage et le type d'origine sont rétablis
  # explicitement (Apache servirait sinon un type générique pour `.br`), et
  # le cache suit la même politique que le fichier non compressé.
  <FilesMatch "\.js\.br$">
    Header set Content-Encoding br
    Header set Content-Type "text/javascript; charset=utf-8"
    Header set Cache-Control no-cache
    Header merge Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.wasm\.br$">
    Header set Content-Encoding br
    Header set Content-Type application/wasm
    Header set Cache-Control "public, max-age=86400"
    Header merge Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.ttf\.br$">
    Header set Content-Encoding br
    Header set Content-Type font/ttf
    Header set Cache-Control "public, max-age=86400"
    Header merge Vary Accept-Encoding
  </FilesMatch>
</IfModule>
