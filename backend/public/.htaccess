<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # L'application Flutter occupe la racine ; PHP ne sert plus que l'API.
    DirectoryIndex index.html index.php

    RewriteEngine On

    # Anciennes adresses publiées sous /site/ : redirection permanente vers la
    # racine, pour que les liens déjà partagés continuent de fonctionner.
    RewriteRule ^site/?(.*)$ /$1 [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # API (et administration Filament) : requêtes traitées par Laravel.
    RewriteRule ^(api|admin|livewire|sanctum|up)(/|$) index.php [L]

    # Pages d'articles pré-rendues et sitemap : Laravel produit le HTML et le
    # XML, pour que les moteurs de recherche et les cartes de partage voient
    # le contenu au lieu de la coquille Flutter.
    RewriteRule ^articles/[^/]+$ index.php [L]
    RewriteRule ^sitemap\.xml$ index.php [L]

    # Fichiers réels : assets Flutter, polices, CanvasKit, manifeste.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Toute autre adresse est une route de l'application (/statistiques,
    # /histoires, /categories/{slug}...) : elle reçoit la page HTML du
    # bootstrap, qui reconstruit l'écran à partir de l'URL.
    RewriteRule ^ index.html [L]
</IfModule>

# Le moteur de rendu de Flutter (CanvasKit) est un WebAssembly de 7,3 Mo et
# le JavaScript pèse près de 3 Mo. Apache ne compresse pas ce WebAssembly par
# défaut : sans ces règles, le premier chargement attendait plus d'une minute
# sur une connexion ordinaire.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Brotli à la volée divise par cinq le débit des gros fichiers (mesuré sur
# main.dart.js : 733 ko en 120 s en brotli contre 833 ko en 28 s en gzip).
# Comme l'application pèse plus de 800 ko de JavaScript, la compression brotli
# empêchait la page de se charger. On la désactive pour les fichiers lourds :
# gzip reste actif et suffit.
<IfModule mod_brotli.c>
  SetEnvIfNoCase Request_URI "\.(js|wasm|json|ttf|otf|woff2?)$" no-brotli
</IfModule>

<IfModule mod_headers.c>
  # Le code doit être revalidé à chaque visite : une réponse 304 coûte quelques
  # centaines d'octets et un déploiement est visible immédiatement.
  <FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # CanvasKit et les polices pèsent plusieurs mégaoctets et ne changent qu'avec
  # une montée de version de Flutter : un jour de cache évite de les reprendre
  # à chaque visite, sans figer durablement une version périmée.
  <FilesMatch "\.(wasm|ttf|otf|woff2?|png|webp|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Les polices d'icônes sont réduites à chaque build : les glyphes changent
  # avec le code. Les garder un jour en cache faisait apparaître vide toute
  # icône ajoutée depuis la visite précédente. Elles pèsent ~13 ko : on les
  # revalide systématiquement.
  <FilesMatch "^(MaterialIcons-Regular\.otf|CupertinoIcons\.ttf)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
