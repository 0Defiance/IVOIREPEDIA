APP_NAME=IVOIREPEDIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8082

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base MySQL du compte Alwaysdata DÉDIÉ à IVOIREPEDIA (voir docs/DEPLOIEMENT.md §2).
# Ce fichier pointe la base de développement ; le serveur utilise ivoirepedia_prod.
# Remplacer `ivoirepedia` par l'identifiant du compte s'il diffère.
DB_CONNECTION=mysql
DB_HOST="mysql-ivoirepedia.alwaysdata.net"
DB_PORT=3306
DB_DATABASE="ivoirepedia_dev"
DB_USERNAME="ivoirepedia_app"
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=127.0.0.1

# Origines de développement autorisées par Sanctum (app Flutter sur :8082,
# API sur :8000) — cf. CONTEXT §7.3
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8082,localhost:8082,127.0.0.1:8000,localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Emails transactionnels : SMTP Mailjet (docs/DEPLOIEMENT.md §4).
# MAIL_USERNAME = clé API Mailjet, MAIL_PASSWORD = clé secrète SMTP.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=in-v3.mailjet.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@ivoirepedia.ci"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
